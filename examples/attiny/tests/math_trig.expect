# value EXPECTED TOLERANCE LABEL: a value sent by the program, within the tolerance
# valuemod: the same, the difference counted around the 16 bit circle
# range LOW HIGH LABEL: a value from LOW to HIGH
# gap MINIMUM_MS: the next value starts at least that long after the last one ended
value 0 3 sin(0)
value 32767 3 cos(0)
value 23169.77 3 sin(8192)
value 23169.77 3 cos(8192)
value 32767 3 sin(16384)
value 0 3 cos(16384)
value -32767 3 sin(-16384)
value 0 3 cos(-16384)
value 30340.83 3 sin(12345)
value 12373.77 3 cos(12345)
value -8593.96 3 sin(-30000)
value -31619.93 3 cos(-30000)
valuemod 8192 4 atan2(100,100)
valuemod -15001.44 4 atan2(-300,40)
valuemod 26298.56 4 atan2(5,-7)
valuemod 32768 4 atan2(0,-1)
valuemod 16383.67 4 atan2(32000,1)
valuemod 0.33 4 atan2(1,32000)
valuemod 5461.33 1 deg_to_rad(30)
valuemod 36408.89 1 deg_to_rad(200)
valuemod 49152 1 deg_to_rad(-90)
value 90 0.5 rad_to_deg(16384)
value -180 0.5 rad_to_deg(-32768)
value 500.02 1 scale(1000,16384)
value -1000 1 scale(-1000,32767)
value 32767 1 scale(32767,32767)
value 32767 1 scale(-32768,-32768)
value -32768 1 scale(-32768,32767)
value -75.0 1 scale(300,-8192)
